# Byte-compiled / cache
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
.venv/
venv/
env/

# Jupyter
.ipynb_checkpoints/
*/.ipynb_checkpoints/
jupyter_notebook_config.py

# Secrets / keys — never commit these
*.pem
*.key
*.p12
*.pfx
.env
.env.*
secrets.*

# Local data / assets referenced by the notebooks (not shipped)
assets/*
!assets/logo.svg
data/*.npz
dat/
*.npz

# Editor / OS noise
.pi/
.vscode/
.idea/
.DS_Store
Thumbs.db
*.swp
